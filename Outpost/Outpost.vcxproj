  <!--
    The shaders, compiled by the BUILD rather than at run time. FXC writes each one to a C array
    in $(IntDir) and CanvasPresenter.cpp includes it, so a typo in HLSL is a build error instead
    of a black window on somebody's machine. Canvas.hlsli is shared by both and is not an entry
    point, so it is carried rather than compiled.
  -->
  <ItemGroup>
    <FxCompile Include="CanvasVertexShader.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>VsMain</EntryPointName>
      <HeaderFileOutput>$(IntDir)%(Filename).h</HeaderFileOutput>
      <VariableName>g_%(Filename)</VariableName>
    </FxCompile>
    <FxCompile Include="CanvasPixelShader.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>PsMain</EntryPointName>
      <HeaderFileOutput>$(IntDir)%(Filename).h</HeaderFileOutput>
      <VariableName>g_%(Filename)</VariableName>
    </FxCompile>
    <None Include="Canvas.hlsli" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="SaveStore.h" />
    <ClInclude Include="Presentation.h" />
    <ClInclude Include="KeyMap.h" />
    <ClInclude Include="Window.h" />
    <ClInclude Include="CanvasPresenter.h" />
    <ClInclude Include="Shell.h" />
  </ItemGroup>
  <!--
