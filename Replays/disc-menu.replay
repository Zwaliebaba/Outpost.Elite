key 2; wait 0.3                    # Save commander: the name field holds JAMESON
key BackSpace; key BackSpace; key BackSpace; key BackSpace; key BackSpace; key BackSpace; key BackSpace
key 1; key Return; wait 0.3        # a name starts with a letter
