# Saves the starting commander as TEST at D10, spends money, and loads it back from D10's catalogue: the commander file goes
# into the replay's own directory, and loading it restores the 100 credits.
wait 3
key space; wait 4
key Escape; wait 1
key 2; wait 1                      # Save commander: the name field holds JAMESON
key BackSpace; key BackSpace; key BackSpace; key BackSpace; key BackSpace; key BackSpace; key BackSpace
key t; key e; key s; key t; wait 0.5
key Return; wait 2                 # TEST.CDR saved
